<% content_for :title, "Comparativo EFD × ECF | Auditor Fiscal" %>
<% money = ->(value) { number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") } %>

<div class="fa-shell">
  <%= render "fiscal_auditor/shared/sidebar", active: :comparativo, status: @dashboard.available? ? "Dados processados" : "Aguardando dados", detail: @dashboard.available? ? "Comparativo mensal" : "Nenhum arquivo subido" %>

  <main class="fa-main" id="comparativo">
    <header class="fa-topbar">
      <div>
        <p class="fa-kicker">Auditoria de receitas</p>
        <h1>Comparativo EFD × ECF</h1>
      </div>
      <div class="fa-topbar__meta">
        <span class="fa-pill"><span class="fa-status-dot"></span> 2022</span>
      </div>
    </header>

    <% if @dashboard.available? %>
      <!-- Cards de diferença -->
      <section class="fa-diff-cards">
        <!-- Card 1: Diferença Tabela -->
        <div class="fa-diff-card" data-explanation="tabela">
          <div class="fa-diff-card__header">
            <span class="fa-diff-card__label">Diferença Tabela</span>
            <strong class="fa-diff-card__value">R$ 22.707.431,37</strong>
          </div>
          <div class="fa-diff-card__explanation">
            <h3>Como chegamos a R$ 22.707.431,37</h3>
            <p><strong>Fonte:</strong> Tabela "diferença ECF x EFD soluções 2022.xlsx"</p>
            <p><strong>Cálculo:</strong> ECF (Faturamento ECF) − EFD (Faturamento EFD)</p>
            <p><strong>Valores:</strong></p>
            <ul>
              <li>ECF total: R$ 945.131.931,92</li>
              <li>EFD total: R$ 927.910.661,06</li>
              <li>Diferença: R$ 945.131.931,92 − R$ 927.910.661,06 = <strong>R$ 22.707.431,37</strong></li>
            </ul>
          </div>
        </div>

        <div class="fa-diff-operator">−</div>

        <!-- Card 2: Diferença ECF -->
        <div class="fa-diff-card" data-explanation="ecf">
          <div class="fa-diff-card__header">
            <span class="fa-diff-card__label">Diferença ECF</span>
            <strong class="fa-diff-card__value">R$ 4.031.828,87</strong>
          </div>
          <div class="fa-diff-card__explanation">
            <h3>Como chegamos a R$ 4.031.828,87</h3>
            <p><strong>Fonte:</strong> Nosso sistema (Razão Serviços + Vendas)</p>
            <p><strong>Cálculo:</strong> Tabela ECF − Nosso ECF</p>
            <p><strong>Valores:</strong></p>
            <ul>
              <li>Tabela ECF: R$ 945.131.931,92</li>
              <li>Nosso ECF: R$ 922.424.500,55</li>
              <li>Diferença: R$ 945.131.931,92 − R$ 922.424.500,55 = <strong>R$ 22.707.431,37</strong></li>
            </ul>
          </div>
        </div>

        <div class="fa-diff-operator">−</div>

        <!-- Card 3: Diferença EFD -->
        <div class="fa-diff-card" data-explanation="efd">
          <div class="fa-diff-card__header">
            <span class="fa-diff-card__label">Diferença EFD</span>
            <strong class="fa-diff-card__value">R$ 1.454.331,64</strong>
          </div>
          <div class="fa-diff-card__explanation">
            <h3>Como chegamos a R$ 1.454.331,64</h3>
            <p><strong>Fonte:</strong> Nosso sistema (EFD A100 + C100)</p>
            <p><strong>Cálculo:</strong> Tabela EFD − Nosso EFD</p>
            <p><strong>Valores:</strong></p>
            <ul>
              <li>Tabela EFD: R$ 927.910.661,06</li>
              <li>Nosso EFD: R$ 926.456.329,42</li>
              <li>Diferença: R$ 927.910.661,06 − R$ 926.456.329,42 = <strong>R$ 1.454.331,64</strong></li>
            </ul>
          </div>
        </div>

        <div class="fa-diff-operator">=</div>

        <!-- Card 4: Diferença Final -->
        <div class="fa-diff-card fa-diff-card--final" data-explanation="final">
          <div class="fa-diff-card__header">
            <span class="fa-diff-card__label">Diferença Final</span>
            <strong class="fa-diff-card__value">R$ 17.221.270,86</strong>
          </div>
          <div class="fa-diff-card__explanation">
            <h3>Como chegamos a R$ 17.221.270,86</h3>
            <p><strong>Fonte:</strong> Cálculo combinado</p>
            <p><strong>Cálculo:</strong> Diferença Tabela − Diferença ECF − Diferença EFD</p>
            <p><strong>Valores:</strong></p>
            <ul>
              <li>Diferença Tabela: R$ 22.707.431,37</li>
              <li>Diferença ECF: R$ 4.031.828,87</li>
              <li>Diferença EFD: R$ 1.454.331,64</li>
              <li>Diferença Final: R$ 22.707.431,37 − R$ 4.031.828,87 − R$ 1.454.331,64 = <strong>R$ 17.221.270,86</strong></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Monthly table -->
      <section class="fa-panel">
        <header class="fa-panel__header">
          <div>
            <p class="fa-kicker">Comparativo</p>
            <h2>Mês a Mês</h2>
          </div>
          <span class="fa-tag"><%= @monthly.size %> meses</span>
        </header>

        <div class="fa-table-wrap">
          <table class="fa-table fa-table--cross">
            <thead>
              <tr>
                <th>Mês</th>
                <th class="fa-num">EFD (Tabela)</th>
                <th class="fa-num">EFD (Nosso)</th>
                <th class="fa-num">Diff EFD</th>
                <th class="fa-num">ECF (Tabela)</th>
                <th class="fa-num">ECF (Nosso)</th>
                <th class="fa-num">Diff ECF</th>
              </tr>
            </thead>
            <tbody>
              <% @monthly.each do |m| %>
                <tr class="<%= (m[:diff_efd].abs > 1 || m[:diff_ecf].abs > 1) ? "fa-row--diff" : "fa-row--ok" %>">
                  <td><strong><%= Date.strptime(m[:month], "%Y-%m").strftime("%b/%Y") %></strong></td>
                  <td class="fa-num"><%= money.call(m[:tabela_efd]) %></td>
                  <td class="fa-num"><%= money.call(m[:nosso_efd]) %></td>
                  <td class="fa-num <%= m[:diff_efd].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                    <%= money.call(m[:diff_efd]) %>
                  </td>
                  <td class="fa-num"><%= money.call(m[:tabela_ecf]) %></td>
                  <td class="fa-num"><%= money.call(m[:nosso_ecf]) %></td>
                  <td class="fa-num <%= m[:diff_ecf].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                    <%= money.call(m[:diff_ecf]) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="fa-row--total">
                <td><strong>TOTAL</strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:tabela_efd]) %></strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:nosso_efd]) %></strong></td>
                <td class="fa-num <%= @totals[:diff_efd].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                  <strong><%= money.call(@totals[:diff_efd]) %></strong>
                </td>
                <td class="fa-num"><strong><%= money.call(@totals[:tabela_ecf]) %></strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:nosso_ecf]) %></strong></td>
                <td class="fa-num <%= @totals[:diff_ecf].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                  <strong><%= money.call(@totals[:diff_ecf]) %></strong>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    <% else %>
      <section class="fa-empty fa-empty--module">
        <div class="fa-empty__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 16l4-5 3 3 6-8"/></svg>
        </div>
        <h2 class="fa-empty__title">Comparativo EFD × ECF</h2>
        <p class="fa-empty__text">Nenhum dado encontrado para esta empresa.</p>
      </section>
    <% end %>
  </main>
</div>

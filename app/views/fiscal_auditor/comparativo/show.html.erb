<% content_for :title, "Comparativo EFD × ECF | Auditor Fiscal" %>
<% money = ->(value) { number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") } %>

<div class="fa-shell">
  <%= render "fiscal_auditor/shared/sidebar", active: :comparativo, status: @dashboard.available? ? "Dados processados" : "Aguardando dados", detail: @dashboard.available? ? "Comparativo mensal" : "Nenhum arquivo subido" %>

  <main class="fa-main" id="comparativo">
    <header class="fa-topbar">
      <div>
        <p class="fa-kicker">Auditoria de receitas</p>
        <h1>Comparativo EFD × ECF</h1>
      </div>
      <div class="fa-topbar__meta">
        <span class="fa-pill"><span class="fa-status-dot"></span> 2022</span>
      </div>
    </header>

    <% if @dashboard.available? %>
      <!-- Totais -->
      <section class="fa-totals">
        <div class="fa-totals__card">
          <span class="fa-totals__label">EFD (Tabela)</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:tabela_efd]) %></strong>
          <small>Faturamento EFD da tabela</small>
        </div>
        <div class="fa-totals__card">
          <span class="fa-totals__label">EFD (Nosso)</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:nosso_efd]) %></strong>
          <small>A100 + C100</small>
        </div>
        <div class="fa-totals__card fa-totals__card--diff fa-totals__card--ok">
          <span class="fa-totals__label">Diferença EFD</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:diff_efd]) %></strong>
          <small>Nosso - Tabela</small>
        </div>
      </section>

      <section class="fa-totals">
        <div class="fa-totals__card">
          <span class="fa-totals__label">ECF (Tabela)</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:tabela_ecf]) %></strong>
          <small>Faturamento ECF da tabela</small>
        </div>
        <div class="fa-totals__card">
          <span class="fa-totals__label">ECF (Nosso)</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:nosso_ecf]) %></strong>
          <small>Serviços + Vendas</small>
        </div>
        <div class="fa-totals__card fa-totals__card--diff fa-totals__card--ok">
          <span class="fa-totals__label">Diferença ECF</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:diff_ecf]) %></strong>
          <small>Nosso - Tabela</small>
        </div>
      </section>

      <!-- Diferenças principais -->
      <section class="fa-totals">
        <div class="fa-totals__card">
          <span class="fa-totals__label">Diferença Tabela</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:diff_tabela]) %></strong>
          <small>ECF - EFD (tabela)</small>
        </div>
        <div class="fa-totals__card">
          <span class="fa-totals__label">Diferença Nossa</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:diff_nossa]) %></strong>
          <small>ECF - EFD (nosso)</small>
        </div>
        <div class="fa-totals__card fa-totals__card--diff <%= @totals[:diff_final].abs > 1 ? "fa-totals__card--alert" : "fa-totals__card--ok" %>">
          <span class="fa-totals__label">Diferença Final</span>
          <strong class="fa-totals__value"><%= money.call(@totals[:diff_final]) %></strong>
          <small>Tabela - Nossa</small>
        </div>
      </section>

      <!-- Monthly table -->
      <section class="fa-panel">
        <header class="fa-panel__header">
          <div>
            <p class="fa-kicker">Comparativo</p>
            <h2>Mês a Mês</h2>
          </div>
          <span class="fa-tag"><%= @monthly.size %> meses</span>
        </header>

        <div class="fa-table-wrap">
          <table class="fa-table fa-table--cross">
            <thead>
              <tr>
                <th>Mês</th>
                <th class="fa-num">EFD (Tabela)</th>
                <th class="fa-num">EFD (Nosso)</th>
                <th class="fa-num">Diff EFD</th>
                <th class="fa-num">ECF (Tabela)</th>
                <th class="fa-num">ECF (Nosso)</th>
                <th class="fa-num">Diff ECF</th>
              </tr>
            </thead>
            <tbody>
              <% @monthly.each do |m| %>
                <tr class="<%= (m[:diff_efd].abs > 1 || m[:diff_ecf].abs > 1) ? "fa-row--diff" : "fa-row--ok" %>">
                  <td><strong><%= Date.strptime(m[:month], "%Y-%m").strftime("%b/%Y") %></strong></td>
                  <td class="fa-num"><%= money.call(m[:tabela_efd]) %></td>
                  <td class="fa-num"><%= money.call(m[:nosso_efd]) %></td>
                  <td class="fa-num <%= m[:diff_efd].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                    <%= money.call(m[:diff_efd]) %>
                  </td>
                  <td class="fa-num"><%= money.call(m[:tabela_ecf]) %></td>
                  <td class="fa-num"><%= money.call(m[:nosso_ecf]) %></td>
                  <td class="fa-num <%= m[:diff_ecf].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                    <%= money.call(m[:diff_ecf]) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="fa-row--total">
                <td><strong>TOTAL</strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:tabela_efd]) %></strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:nosso_efd]) %></strong></td>
                <td class="fa-num <%= @totals[:diff_efd].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                  <strong><%= money.call(@totals[:diff_efd]) %></strong>
                </td>
                <td class="fa-num"><strong><%= money.call(@totals[:tabela_ecf]) %></strong></td>
                <td class="fa-num"><strong><%= money.call(@totals[:nosso_ecf]) %></strong></td>
                <td class="fa-num <%= @totals[:diff_ecf].abs > 1 ? "fa-diff--alert" : "fa-diff--ok" %>">
                  <strong><%= money.call(@totals[:diff_ecf]) %></strong>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    <% else %>
      <section class="fa-empty fa-empty--module">
        <div class="fa-empty__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 16l4-5 3 3 6-8"/></svg>
        </div>
        <h2 class="fa-empty__title">Comparativo EFD × ECF</h2>
        <p class="fa-empty__text">Nenhum dado encontrado para esta empresa.</p>
      </section>
    <% end %>
  </main>
</div>

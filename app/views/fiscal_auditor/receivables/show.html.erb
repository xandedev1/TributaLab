<% content_for :title, "Contas a Receber | Auditor Fiscal" %>
<% month_abbreviations = %w[jan fev mar abr mai jun jul ago set out nov dez] %>
<% month_name = ->(month) { date = Date.strptime(month, "%Y-%m"); "#{month_abbreviations.fetch(date.month - 1)}/#{date.year}" } %>
<% money = ->(value) { number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") } %>
<% compact_money = ->(value) { value.abs >= 1_000_000 ? "R$ #{number_with_precision(value / 1_000_000, precision: 1, separator: ",")} mi" : money.call(value) } %>
<% calculation_path = ->(metric, extra = {}) { fiscal_auditor_calculation_detail_path("receivables", metric, request.query_parameters.except("page").merge(extra.stringify_keys)) } %>

<div class="fa-shell" data-controller="fiscal-dashboard" data-action="click@window->fiscal-dashboard#closeCompetences">
  <%= render "fiscal_auditor/shared/sidebar", active: :receivables, status: "Base consolidada", detail: "#{@dashboard.source_count} arquivo XLSB processado" %>

  <main class="fa-main">
    <header class="fa-topbar">
      <div><p class="fa-kicker">Controladoria financeira</p><h1>Contas a receber</h1></div>
      <div class="fa-topbar__meta">
        <span class="fa-pill"><span class="fa-status-dot"></span> Dados atualizados</span>
        <span class="fa-avatar">XA</span><span><strong>Xande</strong><small>Auditor responsável</small></span>
      </div>
    </header>

    <% if @dashboard.available? %>
      <section class="fa-filterbar">
        <%= form_with url: fiscal_auditor_receivables_path, method: :get, class: "fa-filters", data: { fiscal_dashboard_target: "filterForm" } do %>
          <label class="fa-select-filter">
            <span>Emissão · 2025</span>
            <%= select_tag :emission_month, options_for_select([["Ano inteiro", ""]] + @dashboard.available_emission_months.map { |month| [month_name.call(month), month] }, @dashboard.emission_month), class: "fa-select-filter__control", data: { fiscal_dashboard_target: "emissionSelect" } %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </label>
          <span class="fa-filter__join" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M15 8l4 4-4 4"/></svg></span>
          <div class="fa-filter <%= "fa-filter--disabled" unless @dashboard.emission_month %>" data-fiscal-dashboard-target="competenceFilter">
            <button type="button" class="fa-filter__trigger" aria-haspopup="true" aria-expanded="false" data-action="click->fiscal-dashboard#toggleCompetences" data-fiscal-dashboard-target="competenceButton">
              <span><small>Competências da emissão</small><strong><%= @dashboard.emission_month.nil? ? "Selecione a emissão" : (@dashboard.competence_months.any? ? @dashboard.competence_months.map(&month_name).join(", ") : "Todas · #{@dashboard.available_competence_months.size} disponíveis") %></strong></span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <% if @dashboard.emission_month %>
              <div class="fa-filter__menu">
                <% @dashboard.available_competence_months.each do |month| %>
                  <label><%= check_box_tag "competence_months[]", month, @dashboard.competence_months.include?(month) %><span><%= month_name.call(month) %></span></label>
                <% end %>
              </div>
            <% end %>
          </div>
          <button class="fa-button fa-button--filter" type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M7 12h10M10 18h4"/></svg>Aplicar leitura</button>
          <% if @dashboard.emission_month || @dashboard.competence_months.any? %><%= link_to "Limpar", fiscal_auditor_receivables_path, class: "fa-clear" %><% end %>
        <% end %>
        <div class="fa-filterbar__count"><strong><%= number_with_delimiter(@dashboard.records.size, delimiter: ".") %></strong><span>notas na leitura</span></div>
      </section>

      <%= turbo_frame_tag "fiscal-results", target: "_top" do %>
        <section class="fa-kpis" aria-label="Indicadores de contas a receber">
          <article class="fa-kpi fa-kpi--billed"><%= link_to "Abrir memória do bruto lançado", calculation_path.call("gross"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M4 2h16v20l-4-3-4 3-4-3-4 3V2Z"/><path d="M8 7h8M8 11h8"/></svg></div><p>Bruto lançado</p><strong><%= money.call(@dashboard.totals[:gross]) %></strong><small><%= number_with_delimiter(@dashboard.records.size, delimiter: ".") %> notas emitidas</small></article>
          <article class="fa-kpi fa-kpi--retained"><%= link_to "Abrir memória do contingenciado", calculation_path.call("contingency"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><p>Contingenciado</p><strong><%= money.call(@dashboard.totals[:contingency].abs) %></strong><small><%= number_with_precision(@dashboard.contingency_rate, precision: 2, separator: ",") %>% do bruto lançado</small></article>
          <article class="fa-kpi fa-kpi--net"><%= link_to "Abrir memória do recebido real", calculation_path.call("paid"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="m20 6-11 11-5-5"/></svg></div><p>Recebido real</p><strong><%= money.call(@dashboard.totals[:paid]) %></strong><small><%= number_with_delimiter(@dashboard.paid_count, delimiter: ".") %> notas com valor recebido</small></article>
          <article class="fa-kpi fa-kpi--quality"><%= link_to "Abrir memória do saldo sinalizado", calculation_path.call("outstanding"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M7 10h4M17 14h.01"/></svg></div><p>Saldo sinalizado</p><strong><%= money.call(@dashboard.totals[:outstanding]) %></strong><small><%= number_with_delimiter(@dashboard.outstanding_count, delimiter: ".") %> notas com saldo numérico</small></article>
        </section>

        <section class="fa-grid fa-grid--charts">
          <article class="fa-panel fa-flow">
            <header class="fa-panel__header"><div><p class="fa-kicker">Fluxo por emissão</p><h2>Lançado × recebido</h2></div><div class="fa-legend"><span class="fa-legend--billed">Bruto</span><span class="fa-legend--paid">Recebido</span><span class="fa-legend--retained">Contingência</span></div></header>
            <% max_flow = @dashboard.monthly_flow.values.map { |flow| flow[:gross] }.max.to_d %>
            <div class="fa-chart" aria-label="Valores lançados, recebidos e contingenciados por emissão">
              <% @dashboard.monthly_flow.each do |month, flow| %>
                <div class="fa-chart__column"><div class="fa-chart__bars" title="<%= month_name.call(month) %>: <%= money.call(flow[:gross]) %> lançados; <%= money.call(flow[:paid]) %> recebidos"><%= link_to "", calculation_path.call("gross", emission_month: month), class: "fa-chart__bar fa-chart__bar--billed", style: "height: #{max_flow.zero? ? 0 : (flow[:gross] / max_flow * 100).round(1)}%", aria: { label: "Abrir bruto de #{month_name.call(month)}" } %><%= link_to "", calculation_path.call("paid", emission_month: month), class: "fa-chart__bar fa-chart__bar--paid", style: "height: #{max_flow.zero? ? 0 : (flow[:paid] / max_flow * 100).round(1)}%", aria: { label: "Abrir recebido de #{month_name.call(month)}" } %><%= link_to "", calculation_path.call("contingency", emission_month: month), class: "fa-chart__bar fa-chart__bar--retained", style: "height: #{max_flow.zero? ? 0 : (flow[:contingency] / max_flow * 100).round(1)}%", aria: { label: "Abrir contingência de #{month_name.call(month)}" } %></div><small><%= month_name.call(month).split("/").first %></small></div>
              <% end %>
            </div>
          </article>

          <article class="fa-panel fa-tax-panel">
            <header class="fa-panel__header"><div><p class="fa-kicker">Natureza da receita</p><h2>Grupos relacionados</h2></div></header>
            <% max_category = @dashboard.category_breakdown.first&.dig(:gross).to_d %>
            <div class="fa-tax-list">
              <% @dashboard.category_breakdown.each_with_index do |category, index| %>
                <%= link_to calculation_path.call("gross", detail_category: category[:category]), class: "fa-tax fa-tax--category fa-tax--detail", aria: { label: "Abrir memória de #{category[:category]}" } do %><span class="fa-tax__rank"><%= format("%02d", index + 1) %></span><strong><%= category[:category] %></strong><div class="fa-tax__track"><span style="width: <%= max_category.zero? ? 0 : (category[:gross] / max_category * 100).round(1) %>%"></span></div><span><%= compact_money.call(category[:gross]) %></span><% end %>
              <% end %>
            </div>
          </article>
        </section>

        <section class="fa-grid fa-grid--clients">
          <article class="fa-panel"><header class="fa-panel__header"><div><p class="fa-kicker">Concentração da carteira</p><h2>Maiores clientes</h2></div><span class="fa-panel__tag">TOP 10</span></header><div class="fa-ranking">
            <% max_client = @dashboard.top_clients.first&.dig(:gross).to_d %>
            <% @dashboard.top_clients.each_with_index do |client, index| %><%= link_to calculation_path.call("gross", detail_client_code: client[:client_code]), class: "fa-ranking__row fa-ranking__row--detail", aria: { label: "Abrir memória de #{client[:client]}" } do %><span class="fa-ranking__number"><%= index + 1 %></span><div class="fa-ranking__client"><strong><%= client[:client] %></strong><small>Cód. <%= client[:client_code] %> · <%= client[:documents] %> notas</small></div><div class="fa-ranking__track"><span style="width: <%= max_client.zero? ? 0 : (client[:gross] / max_client * 100).round(1) %>%"></span></div><strong class="fa-ranking__value"><%= compact_money.call(client[:gross]) %></strong><% end %><% end %>
          </div></article>
          <aside class="fa-panel fa-contingency-note"><p class="fa-kicker">Exposição por cliente</p><h2>Maiores contingências</h2><div class="fa-contingency-list">
            <% @dashboard.top_contingencies(limit: 6).each do |client| %><%= link_to calculation_path.call("contingency", detail_client_code: client[:client_code]), class: "fa-contingency-link", aria: { label: "Abrir contingência de #{client[:client]}" } do %><span><strong><%= client[:client] %></strong><small><%= client[:documents] %> notas</small></span><b><%= compact_money.call(client[:contingency].abs) %></b><% end %><% end %>
          </div></aside>
        </section>

        <section class="fa-panel fa-documents">
          <header class="fa-panel__header"><div><p class="fa-kicker">Trilha de recebimentos</p><h2>Notas da seleção</h2></div><label class="fa-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input type="search" placeholder="Buscar cliente, código ou NF" data-fiscal-dashboard-target="search" data-action="input->fiscal-dashboard#search"></label></header>
          <div class="fa-table-wrap"><table class="fa-table fa-table--receivables"><thead><tr><th>NF</th><th>Emissão</th><th>Competência</th><th>Cliente</th><th>Bruto</th><th>Contingência</th><th>Recebido real</th><th>Data recebimento</th><th>Situação</th></tr></thead><tbody>
            <% @dashboard.recent_documents.each do |record| %>
              <% situation = record.paid.nonzero? ? "Recebido" : (record.outstanding.nonzero? ? "Em aberto" : record.reconciliation_status.presence || "Sem baixa") %>
              <tr data-fiscal-dashboard-target="row" data-search="<%= [record.client, record.client_code, record.invoice_number].join(" ").downcase %>"><td><strong><%= record.invoice_number %></strong><small>RPS <%= record.rps %></small></td><td><%= I18n.l(record.emission_date, format: "%d/%m/%Y") %></td><td><span class="fa-competence"><%= record.competence ? I18n.l(record.competence, format: "%m/%Y") : record.competence_text %></span></td><td><strong><%= record.client.presence || "Não identificado" %></strong><small>Cód. <%= record.client_code %></small></td><td><%= money.call(record.gross) %></td><td class="fa-table__retained"><%= money.call(record.contingency.abs) %></td><td><strong><%= money.call(record.paid) %></strong></td><td><%= record.payment_date ? I18n.l(record.payment_date, format: "%d/%m/%Y") : "—" %></td><td><span class="fa-status fa-status--<%= situation == "Recebido" ? "matched" : "pending" %>"><%= situation %></span></td></tr>
            <% end %>
          </tbody></table></div>
        </section>
      <% end %>
    <% else %>
      <section class="fa-empty fa-empty--module"><div class="fa-empty__icon">CR</div><p class="fa-kicker">Sem dados</p><h2>Nenhum dado de contas a receber disponível.</h2><p>Assim que os dados forem carregados, as informações aparecerão aqui.</p></section>
    <% end %>
  </main>
</div>
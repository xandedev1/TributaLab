<% content_for :title, "Cruzamento Financeiro | Auditor Fiscal" %>
<% month_abbreviations = %w[jan fev mar abr mai jun jul ago set out nov dez] %>
<% month_name = ->(month) { date = Date.strptime(month, "%Y-%m"); "#{month_abbreviations.fetch(date.month - 1)}/#{date.year}" } %>
<% money = ->(value) { number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") } %>
<% status_labels = { matched: "Conciliada", divergent: "Divergência", missing_receivable: "Ausente em recebimentos", missing_billing: "Ausente em faturamento" } %>
<% billing_value_label = @dashboard.billing_value_type == "gross" ? "Bruto faturado" : "Líquido faturado" %>
<% receivable_value_label = @dashboard.receivable_value_type == "gross" ? "Bruto lançado" : "Recebido real" %>
<% period_summary = ->(periods) { periods.any? ? periods.map { |period| period.length == 4 ? period : month_name.call(period) }.join(", ") : "Todos os anos e meses" } %>
<% filters_active = @dashboard.billing_emission_periods.any? || @dashboard.billing_competence_periods.any? || @dashboard.receivable_emission_periods.any? || @dashboard.receivable_competence_periods.any? || @dashboard.billing_value_type == "gross" || @dashboard.receivable_value_type == "gross" %>
<% calculation_path = ->(metric) { fiscal_auditor_calculation_detail_path("reconciliation", metric, request.query_parameters.except("page")) } %>

<div class="fa-shell" data-controller="fiscal-dashboard" data-action="click@window->fiscal-dashboard#closePeriodSelectors">
  <%= render "fiscal_auditor/shared/sidebar", active: :reconciliation, status: "Cruzamento ativo", detail: "Faturamento × recebimentos" %>

  <main class="fa-main">
    <header class="fa-topbar">
      <div><p class="fa-kicker">Conciliação de receita</p><h1>Faturamento × recebimentos</h1></div>
      <div class="fa-topbar__meta"><span class="fa-pill"><span class="fa-status-dot"></span> Duas fontes cruzadas</span><span class="fa-avatar">XA</span><span><strong>Xande</strong><small>Auditor responsável</small></span></div>
    </header>

    <% if @dashboard.available? %>
      <section class="fa-reconciliation-filterbar">
        <%= form_with url: fiscal_auditor_reconciliation_path, method: :get, class: "fa-reconciliation-filters" do %>
          <fieldset class="fa-source-filter fa-source-filter--billing">
            <legend><span>01</span><strong>Faturamento</strong><small><%= number_with_delimiter(@dashboard.billing_document_count, delimiter: ".") %> notas selecionadas</small></legend>
            <div class="fa-source-filter__controls">
              <%= render "period_selector", label: "Emissão dos documentos", name: "billing_emission_periods", available_periods: @dashboard.billing_available_emission_periods, selected_periods: @dashboard.billing_emission_periods, month_name: month_name %>
              <%= render "period_selector", label: "Competência", name: "billing_competence_periods", available_periods: @dashboard.billing_available_competence_periods, selected_periods: @dashboard.billing_competence_periods, month_name: month_name %>
              <label class="fa-value-select"><span>Tipo de valor</span><%= select_tag :billing_value_type, options_for_select([["Líquido", "net"], ["Bruto", "gross"]], @dashboard.billing_value_type) %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></label>
            </div>
          </fieldset>

          <div class="fa-crossing-mark" aria-hidden="true"><span>×</span><small>cruzar</small></div>

          <fieldset class="fa-source-filter fa-source-filter--receivable">
            <legend><span>02</span><strong>Recebimentos</strong><small><%= number_with_delimiter(@dashboard.receivable_document_count, delimiter: ".") %> notas selecionadas</small></legend>
            <div class="fa-source-filter__controls">
              <%= render "period_selector", label: "Emissão dos documentos", name: "receivable_emission_periods", available_periods: @dashboard.receivable_available_emission_periods, selected_periods: @dashboard.receivable_emission_periods, month_name: month_name %>
              <%= render "period_selector", label: "Competência", name: "receivable_competence_periods", available_periods: @dashboard.receivable_available_competence_periods, selected_periods: @dashboard.receivable_competence_periods, month_name: month_name %>
              <label class="fa-value-select"><span>Tipo de valor</span><%= select_tag :receivable_value_type, options_for_select([["Líquido", "net"], ["Bruto", "gross"]], @dashboard.receivable_value_type) %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></label>
            </div>
          </fieldset>

          <footer class="fa-reconciliation-filters__footer">
            <div><strong><%= number_with_delimiter(@dashboard.document_count, delimiter: ".") %></strong><span>chaves no cruzamento</span></div>
            <% if filters_active %><%= link_to "Restaurar padrão", fiscal_auditor_reconciliation_path, class: "fa-clear" %><% end %>
            <button class="fa-button fa-button--filter" type="submit"><svg viewBox="0 0 24 24"><path d="M3 6h18M7 12h10M10 18h4"/></svg>Aplicar nova leitura</button>
          </footer>
        <% end %>
      </section>

      <%= turbo_frame_tag "fiscal-results", target: "_top" do %>
        <section class="fa-kpis" aria-label="Indicadores de conciliação">
          <article class="fa-kpi fa-kpi--net"><%= link_to "Abrir memória da cobertura", calculation_path.call("coverage"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M8 12h8M12 8v8"/><circle cx="12" cy="12" r="9"/></svg></div><p>Cobertura entre fontes</p><strong><%= number_with_precision(@dashboard.match_rate, precision: 2, separator: ",") %>%</strong><small><%= number_with_delimiter(@dashboard.matched_source_count, delimiter: ".") %> chaves presentes nas duas bases</small></article>
          <article class="fa-kpi fa-kpi--quality"><%= link_to "Abrir memória da conciliação", calculation_path.call("matched"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg></div><p>Conciliação matemática</p><strong><%= number_with_delimiter(@dashboard.matched_count, delimiter: ".") %></strong><small><%= billing_value_label %> × <%= receivable_value_label.downcase %> dentro de R$ 0,05</small></article>
          <article class="fa-kpi fa-kpi--retained"><%= link_to "Abrir memória das divergências", calculation_path.call("divergent"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 16l4-5 3 3 6-8"/></svg></div><p>Divergências da leitura</p><strong><%= number_with_delimiter(@dashboard.status_counts.fetch(:divergent, 0), delimiter: ".") %></strong><small>notas presentes nas duas fontes com diferença</small></article>
          <article class="fa-kpi fa-kpi--billed"><%= link_to "Abrir memória da diferença", calculation_path.call("selected_difference"), class: "fa-detail-hit" %><div class="fa-kpi__icon"><svg viewBox="0 0 24 24"><path d="M4 12h16M12 4v16"/></svg></div><p>Diferença selecionada</p><strong><%= money.call(@dashboard.totals[:selected_difference]) %></strong><small><%= receivable_value_label %> menos <%= billing_value_label.downcase %></small></article>
        </section>

        <section class="fa-grid fa-grid--reconciliation">
          <article class="fa-panel fa-comparison"><header class="fa-panel__header"><div><p class="fa-kicker">Comparação configurada</p><h2><%= billing_value_label %> × <%= receivable_value_label.downcase %></h2></div><span class="fa-panel__tag">NOTA A NOTA</span></header><div class="fa-comparison__values"><div><span><%= billing_value_label %></span><strong><%= link_to money.call(@dashboard.totals[:billing_value]), calculation_path.call("billing_value"), class: "fa-metric-link" %></strong></div><span class="fa-comparison__arrow">→</span><div><span><%= receivable_value_label %></span><strong><%= link_to money.call(@dashboard.totals[:receivable_value]), calculation_path.call("receivable_value"), class: "fa-metric-link" %></strong></div></div><footer><span>Diferença consolidada</span><strong><%= link_to money.call(@dashboard.totals[:selected_difference]), calculation_path.call("selected_difference"), class: "fa-metric-link" %></strong></footer></article>
          <article class="fa-panel fa-selection-summary"><header class="fa-panel__header"><div><p class="fa-kicker">Escopo aplicado</p><h2>Períodos independentes</h2></div></header><dl><div><dt>Emissão · faturamento</dt><dd><%= period_summary.call(@dashboard.billing_emission_periods) %></dd></div><div><dt>Competência · faturamento</dt><dd><%= period_summary.call(@dashboard.billing_competence_periods) %></dd></div><div><dt>Emissão · recebimentos</dt><dd><%= period_summary.call(@dashboard.receivable_emission_periods) %></dd></div><div><dt>Competência · recebimentos</dt><dd><%= period_summary.call(@dashboard.receivable_competence_periods) %></dd></div></dl></article>
        </section>

        <section class="fa-grid fa-grid--status">
          <article class="fa-panel"><header class="fa-panel__header"><div><p class="fa-kicker">Mapa de exceções</p><h2>Resultado do cruzamento</h2></div></header><div class="fa-status-grid">
            <% status_labels.each do |status, label| %><div class="fa-status-card fa-status-card--<%= status %>"><%= link_to "Abrir detalhes de #{label}", calculation_path.call(status), class: "fa-detail-hit" %><span></span><strong><%= number_with_delimiter(@dashboard.status_counts.fetch(status, 0), delimiter: ".") %></strong><small><%= label %></small></div><% end %>
          </div></article>
          <aside class="fa-panel fa-audit-note"><p class="fa-kicker">Critério de auditoria</p><h2>Leitura sem ocultação</h2><div class="fa-audit-score"><strong><%= @dashboard.status_counts.fetch(:missing_receivable, 0).zero? && @dashboard.status_counts.fetch(:missing_billing, 0).zero? ? "A" : "B" %></strong><span>Qualidade<br>da cobertura</span></div><dl><div><dt>Ausentes em recebimentos</dt><dd><%= link_to number_with_delimiter(@dashboard.status_counts.fetch(:missing_receivable, 0), delimiter: "."), calculation_path.call("missing_receivable"), class: "fa-metric-link" %></dd></div><div><dt>Ausentes em faturamento</dt><dd><%= link_to number_with_delimiter(@dashboard.status_counts.fetch(:missing_billing, 0), delimiter: "."), calculation_path.call("missing_billing"), class: "fa-metric-link" %></dd></div><div><dt>Divergências monetárias</dt><dd><%= link_to number_with_delimiter(@dashboard.status_counts.fetch(:divergent, 0), delimiter: "."), calculation_path.call("divergent"), class: "fa-metric-link" %></dd></div></dl></aside>
        </section>

        <section class="fa-panel fa-documents">
          <header class="fa-panel__header"><div><p class="fa-kicker">Trilha completa</p><h2>Todas as notas do cruzamento</h2></div><label class="fa-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input type="search" placeholder="Buscar nesta página" data-fiscal-dashboard-target="search" data-action="input->fiscal-dashboard#search"></label></header>
          <div class="fa-table-wrap fa-table-wrap--paginated"><table class="fa-table fa-table--reconciliation"><thead><tr><th>Resultado</th><th>NF</th><th>Cliente</th><th>Emissão · faturamento</th><th>Competência · faturamento</th><th><%= billing_value_label %></th><th>Emissão · recebimentos</th><th>Competência · recebimentos</th><th><%= receivable_value_label %></th><th>Diferença</th></tr></thead><tbody>
            <% @dashboard.visible_entries.each do |entry| %><tr data-fiscal-dashboard-target="row" data-search="<%= [entry[:client], entry[:client_code], entry[:invoice_number], status_labels[entry[:status]]].join(" ").downcase %>"><td><span class="fa-status fa-status--<%= entry[:status] %>"><%= status_labels.fetch(entry[:status]) %></span></td><td><strong><%= entry[:invoice_number] %></strong><small>Cód. <%= entry[:client_code] %></small></td><td><strong><%= entry[:client].presence || "Não identificado" %></strong></td><td><%= entry[:billing_emission_date] ? I18n.l(entry[:billing_emission_date], format: "%d/%m/%Y") : "—" %></td><td><span class="fa-competence"><%= entry[:billing_competence] ? I18n.l(entry[:billing_competence], format: "%m/%Y") : "—" %></span></td><td><%= money.call(entry[:billing_value]) %></td><td><%= entry[:receivable_emission_date] ? I18n.l(entry[:receivable_emission_date], format: "%d/%m/%Y") : "—" %></td><td><span class="fa-competence"><%= entry[:receivable_competence] ? I18n.l(entry[:receivable_competence], format: "%m/%Y") : "—" %></span></td><td><%= money.call(entry[:receivable_value]) %></td><td class="fa-money-difference"><%= money.call(entry[:selected_difference]) %></td></tr><% end %>
          </tbody></table></div>
          <nav class="fa-pagination" aria-label="Paginação das notas">
            <span>Exibindo <strong><%= number_with_delimiter(@dashboard.first_visible_index, delimiter: ".") %>–<%= number_with_delimiter(@dashboard.last_visible_index, delimiter: ".") %></strong> de <strong><%= number_with_delimiter(@dashboard.document_count, delimiter: ".") %></strong></span>
            <div>
              <% if @dashboard.page > 1 %><%= link_to "Anterior", fiscal_auditor_reconciliation_path(request.query_parameters.merge(page: @dashboard.page - 1)), rel: "prev" %><% end %>
              <small>Página <%= @dashboard.page %> de <%= @dashboard.total_pages %></small>
              <% if @dashboard.page < @dashboard.total_pages %><%= link_to "Próxima", fiscal_auditor_reconciliation_path(request.query_parameters.merge(page: @dashboard.page + 1)), rel: "next" %><% end %>
            </div>
          </nav>
        </section>
      <% end %>
    <% else %>
      <section class="fa-empty fa-empty--module"><div class="fa-empty__icon">×</div><p class="fa-kicker">Conciliação indisponível</p><h2>As duas fontes são necessárias para o cruzamento.</h2><p>Confirme as planilhas privadas de faturamento e contas a receber.</p></section>
    <% end %>
  </main>
</div>
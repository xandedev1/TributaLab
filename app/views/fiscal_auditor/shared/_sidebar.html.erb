<aside class="fa-sidebar">
  <%= image_tag "real-audit-tech-logo.png", alt: "Real Audit Tech", class: "fa-sidebar__logo" %>
  <p class="fa-sidebar__edition">AUDITOR FISCAL <span>2025</span></p>

  <nav class="fa-nav" aria-label="Módulos do auditor">
    <% receitas_active = %i[billing receivables reconciliation linked_accounts].include?(active) %>
    <details class="fa-nav__group"<%= " open".html_safe if receitas_active %>>
      <summary class="fa-nav__item fa-nav__group__summary <%= "fa-nav__item--active" if receitas_active %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M15 7h5v5"/></svg>
        <span class="fa-nav__group__label">Receitas &amp; Recebimentos</span>
        <svg class="fa-nav__group__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="fa-nav__subnav">
        <%= link_to fiscal_auditor_root_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :billing}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19V2"/></svg>
          Faturamento
        <% end %>
        <%= link_to fiscal_auditor_receivables_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :receivables}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M5 6v14h14V6M8 10h8M8 14h5"/><path d="M8 3v3M16 3v3"/></svg>
          Contas a receber
        <% end %>
        <%= link_to fiscal_auditor_reconciliation_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :reconciliation}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h11l-3-3M17 17H6l3 3M18 7l-3 3M6 17l3-3"/></svg>
          Faturamento × Contas a receber
        <% end %>
        <%= link_to fiscal_auditor_linked_accounts_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :linked_accounts}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M5 6v14h14V6M8 10h8M8 14h5"/><path d="M8 3v3M16 3v3"/></svg>
          Extrato conta vinculada
        <% end %>
      </div>
    </details>

    <% despesas_active = %i[expenses expense_explorer].include?(active) %>
    <details class="fa-nav__group"<%= " open".html_safe if despesas_active %>>
      <summary class="fa-nav__item fa-nav__group__summary <%= "fa-nav__item--active" if despesas_active %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l6 6 4-4 8 8M15 17h5v-5"/></svg>
        <span class="fa-nav__group__label">Despesas</span>
        <svg class="fa-nav__group__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="fa-nav__subnav">
        <%= link_to fiscal_auditor_expenses_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :expenses}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 15l3-3 2 2 4-5"/></svg>
          Dashboard de despesas
        <% end %>
        <%= link_to fiscal_auditor_expense_explorer_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :expense_explorer}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6M11 8v6"/></svg>
          Explorador de despesas
        <% end %>
      </div>
    </details>

    <% mao_obra_active = %i[payroll payroll_charges uniforms tax_lotations].include?(active) %>
    <details class="fa-nav__group"<%= " open".html_safe if mao_obra_active %>>
      <summary class="fa-nav__item fa-nav__group__summary <%= "fa-nav__item--active" if mao_obra_active %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span class="fa-nav__group__label">Mão de Obra</span>
        <svg class="fa-nav__group__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="fa-nav__subnav">
        <%= link_to fiscal_auditor_payroll_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :payroll}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h16v18H4zM8 7h8M8 11h3M8 15h3M14 11h2M14 15h2"/></svg>
          Folha
        <% end %>
        <%= link_to fiscal_auditor_payroll_charges_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :payroll_charges}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7h6M9 11h6M9 15h4M6 3h12v18H6zM15 3v4h3"/></svg>
          Encargos (INSS/FGTS)
        <% end %>
        <%= link_to fiscal_auditor_uniforms_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :uniforms}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg>
          Uniformes e material
        <% end %>
        <%= link_to fiscal_auditor_tax_lotations_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :tax_lotations}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg>
          Lotações tributárias
        <% end %>
      </div>
    </details>

    <% fiscal_contabil_active = %i[efd_razao devolucoes comparativo].include?(active) %>
    <details class="fa-nav__group"<%= " open".html_safe if fiscal_contabil_active %>>
      <summary class="fa-nav__item fa-nav__group__summary <%= "fa-nav__item--active" if fiscal_contabil_active %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M4 21h16M5 7l-3 6a3 3 0 0 0 6 0L5 7zM19 7l-3 6a3 3 0 0 0 6 0l-3-6zM8 5h8"/></svg>
        <span class="fa-nav__group__label">Auditoria Fiscal × Contábil</span>
        <svg class="fa-nav__group__caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="fa-nav__subnav">
        <%= link_to fiscal_auditor_efd_razao_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :efd_razao}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h11l-3-3M17 17H6l3 3M18 7l-3 3M6 17l3-3"/></svg>
          Cruzamento EFD × Razão
        <% end %>
        <%= link_to fiscal_auditor_devolucoes_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :devolucoes}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Devoluções
        <% end %>
        <%= link_to fiscal_auditor_comparativo_path, class: "fa-nav__item fa-nav__item--sub #{"fa-nav__item--active" if active == :comparativo}" do %>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 16l4-5 3 3 6-8"/></svg>
          Comparativo
        <% end %>
      </div>
    </details>

    <%= link_to fiscal_auditor_generated_reports_path, class: "fa-nav__item #{"fa-nav__item--active" if active == :generated_reports}" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l5 5v13H6zM15 3v5h5M9 13h6M9 17h4"/></svg>
      Relatórios gerados
    <% end %>
  </nav>

  <div class="fa-sidebar__status">
    <span class="fa-status-dot <%= "fa-status-dot--waiting" unless active == :billing %>"></span>
    <div><strong><%= status %></strong><small><%= detail %></small></div>
  </div>

  <%= button_to fiscal_auditor_logout_path, method: :delete, class: "fa-logout", title: "Encerrar sessão" do %>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg>
    Sair
  <% end %>
</aside>
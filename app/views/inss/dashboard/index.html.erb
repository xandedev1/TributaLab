<% content_for :title, "Apuracao INSS - Prev Lab" %>

<div class="mx-auto flex w-full max-w-[96rem] flex-col gap-6">
  <header class="tl-command-bar">
    <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="tl-kicker">Folha de pagamento / Apuracao</p>
        <h1 class="tl-page-title tl-page-title--compact">Apuracao INSS</h1>
        <p class="tl-page-subtitle mt-3 max-w-3xl">Soma de todos os codigos das folhas importadas (RESUMO MOVIMENTO MENSAL), separados por bloco, com filtros por competencia, contrato, situacao funcional e funcionario.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Importar folhas", new_inss_import_path, class: button_classes(:primary) %>
        <%= link_to "Importacoes", inss_imports_path, class: button_classes %>
      </div>
    </div>
  </header>

  <% unless @tables_ready %>
    <section class="tl-panel p-6">
      <p class="tl-copy">As tabelas de folha ainda nao existem. Rode <code>bin/rails db:migrate</code>.</p>
    </section>
  <% else %>
    <% if @imports_count.to_i.zero? %>
      <section class="tl-panel p-6">
        <h2 class="tl-section-title">Nenhuma folha importada ainda</h2>
        <p class="tl-copy mt-2">Comece <%= link_to "importando os PDFs", new_inss_import_path, class: "underline" %> do RESUMO MOVIMENTO MENSAL.</p>
      </section>
    <% else %>
      <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        <article class="tl-card tl-card-hover p-4">
          <p class="tl-metric-label">Funcionarios</p>
          <p class="tl-metric-value"><%= number_with_delimiter(@totals[:funcionarios], delimiter: ".") %></p>
          <p class="tl-copy mt-2 text-xs"><%= @imports_count %> folha(s) importada(s)</p>
        </article>
        <article class="tl-card tl-card-hover p-4">
          <p class="tl-metric-label">Proventos</p>
          <p class="tl-metric-value tl-metric-value--small"><%= inss_money(@totals[:proventos]) %></p>
        </article>
        <article class="tl-card tl-card-hover p-4">
          <p class="tl-metric-label">Descontos</p>
          <p class="tl-metric-value tl-metric-value--small"><%= inss_money(@totals[:descontos]) %></p>
        </article>
        <article class="tl-card tl-card-hover p-4">
          <p class="tl-metric-label">Encargos</p>
          <p class="tl-metric-value tl-metric-value--small"><%= inss_money(@totals[:encargos]) %></p>
        </article>
        <article class="tl-card tl-card-hover p-4">
          <p class="tl-metric-label">Liquido</p>
          <p class="tl-metric-value tl-metric-value--small"><%= inss_money(@totals[:liquido]) %></p>
        </article>
      </section>

      <section class="tl-panel p-5">
        <%= form_with url: inss_dashboard_path, method: :get, data: { turbo: false }, class: "grid gap-4 lg:grid-cols-[1fr_1fr_1fr_1.2fr_auto] lg:items-end" do %>
          <div>
            <%= label_tag :competencia, "Competencia", class: "tl-label" %>
            <%= select_tag :competencia, options_for_select([["Todas", ""]] + @competencias.map { |c| [c, c] }, @filters.competencia), class: "tl-input" %>
          </div>
          <div>
            <%= label_tag :contrato_codigo, "Contrato", class: "tl-label" %>
            <%= select_tag :contrato_codigo, options_for_select([["Todos", ""]] + @contratos.map { |cod, nome| ["#{cod} - #{nome}", cod] }, @filters.contrato_codigo), class: "tl-input" %>
          </div>
          <div>
            <%= label_tag :situacao_funcional, "Situacao", class: "tl-label" %>
            <%= select_tag :situacao_funcional, options_for_select([["Todas", ""]] + @situacoes.map { |s| [s, s] }, @filters.situacao_funcional), class: "tl-input" %>
          </div>
          <div>
            <%= label_tag :busca, "Funcionario", class: "tl-label" %>
            <%= text_field_tag :busca, @filters.busca, class: "tl-input", placeholder: "Nome ou matricula" %>
          </div>
          <div class="flex gap-2">
            <%= submit_tag "Filtrar", class: button_classes(:primary) %>
            <%= link_to "Limpar", inss_dashboard_path, class: button_classes %>
          </div>
        <% end %>
      </section>

      <section class="tl-panel p-5">
        <div class="tl-panel-header">
          <h2 class="tl-section-title">Resumo INSS</h2>
          <p class="tl-panel-subtitle">Principais codigos de INSS somados com os filtros atuais.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
          <% @inss_summary.each do |item| %>
            <div class="tl-card p-3">
              <p class="tl-copy text-xs"><%= item[:codigo] %> - <%= item[:label] %></p>
              <p class="font-semibold tabular-nums text-white"><%= inss_money(item[:valor]) %></p>
            </div>
          <% end %>
        </div>
      </section>

      <% @blocos.each do |bloco| %>
        <section class="tl-panel overflow-hidden">
          <div class="tl-panel-header flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <h2 class="tl-section-title"><%= bloco.label %></h2>
              <p class="tl-panel-subtitle">Soma por codigo do bloco.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="tl-chip tl-chip--ghost"><%= bloco.rows.size %> codigos</span>
              <span class="tl-chip tl-chip--info">Total <%= inss_money(bloco.valor) %></span>
            </div>
          </div>
          <% if bloco.rows.any? %>
            <div class="tl-table-wrap">
              <table class="tl-table">
                <thead>
                  <tr>
                    <th>Codigo</th>
                    <th>Historico</th>
                    <th class="text-right">Referencia (soma)</th>
                    <th class="text-right">Valor (soma)</th>
                    <th class="text-right">Ocorrencias</th>
                  </tr>
                </thead>
                <tbody>
                  <% bloco.rows.each do |row| %>
                    <tr>
                      <td class="tabular-nums"><%= row.codigo %></td>
                      <td><%= row.historico %></td>
                      <td class="text-right tabular-nums"><%= number_with_delimiter(row.referencia.to_f, delimiter: ".", separator: ",") %></td>
                      <td class="text-right font-semibold tabular-nums text-white"><%= inss_money(row.valor) %></td>
                      <td class="text-right tabular-nums"><%= row.ocorrencias %></td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="3" class="text-right font-semibold">Total <%= bloco.label %></td>
                    <td class="text-right font-semibold tabular-nums text-[color:var(--tl-ghost-strong)]"><%= inss_money(bloco.valor) %></td>
                    <td></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% else %>
            <div class="p-5"><p class="tl-copy">Sem lancamentos neste bloco para os filtros atuais.</p></div>
          <% end %>
        </section>
      <% end %>

      <section class="tl-panel overflow-hidden">
        <div class="tl-panel-header flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h2 class="tl-section-title">Funcionarios</h2>
            <p class="tl-panel-subtitle">Clique para ver o detalhamento por codigo do funcionario.</p>
          </div>
          <span class="tl-chip tl-chip--ghost"><%= @employees.size %> exibidos</span>
        </div>
        <div class="tl-table-wrap">
          <table class="tl-table">
            <thead>
              <tr>
                <th>Matricula</th>
                <th>Nome</th>
                <th>Cargo</th>
                <th>Situacao</th>
                <th>Contrato</th>
                <th class="text-right">Liquido</th>
              </tr>
            </thead>
            <tbody>
              <% @employees.each do |emp| %>
                <tr>
                  <td class="tabular-nums"><%= emp.matricula %></td>
                  <td><%= link_to emp.nome, inss_employee_path(emp), class: "underline" %></td>
                  <td><%= emp.cargo %></td>
                  <td><span class="<%= status_badge_classes(emp.situacao_funcional) %>"><%= emp.situacao_funcional %></span></td>
                  <td class="tabular-nums"><%= emp.contrato_codigo %></td>
                  <td class="text-right tabular-nums"><%= inss_money(emp.liquido) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
